# Data — never commit raw, intermediate, or processed datasets.
data/raw/*
data/interim/*
data/processed/*
data/snapshots/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained model bundles (.cbm + .meta.json) — regenerated by `vininator train`.
data/models/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Notebooks
.ipynb_checkpoints/

# Experiment tracking (MLflow local runs)
mlruns/

# CatBoost training scratch (created only if allow_writing_files is left on)
catboost_info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
